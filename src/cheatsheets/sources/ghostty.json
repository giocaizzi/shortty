{
  "id": "ghostty",
  "label": "Ghostty",
  "icon": "👻",
  "platforms": ["darwin", "linux"],
  "parser": "ghostty",
  "mergeMode": "additive",
  "lastVerified": { "version": "1.3.1", "date": "2026-10-14" },
  "defaultPaths": {
    "darwin": ["$XDG_CONFIG_HOME/ghostty/config.ghostty", "$XDG_CONFIG_HOME/ghostty/config", "~/Library/Application Support/com.mitchellh.ghostty/config.ghostty", "~/Library/Application Support/com.mitchellh.ghostty/config"],
    "linux": ["$XDG_CONFIG_HOME/ghostty/config.ghostty", "$XDG_CONFIG_HOME/ghostty/config"]
  },
  "shortcuts": [
    {
      "command": "New Tab",
      "rawCommand": "ghostty.new_tab",
      "key": { "darwin": "Cmd+T", "linux": "Ctrl+Shift+T" },
      "category": "Tab"
    },
    {
      "command": "Close Surface",
      "rawCommand": "ghostty.close_surface",
      "key": { "darwin": "Cmd+W" },
      "category": "Tab"
    },
    {
      "command": "Close Tab",
      "rawCommand": "ghostty.close_tab:this",
      "key": { "darwin": "Cmd+Alt+W", "linux": "Ctrl+Shift+W" },
      "category": "Tabs"
    },
    {
      "command": "Next Tab",
      "rawCommand": "ghostty.next_tab",
      "key": { "darwin": "Cmd+Shift+]", "linux": "Ctrl+PageDown" },
      "category": "Tab"
    },
    {
      "command": "Previous Tab",
      "rawCommand": "ghostty.previous_tab",
      "key": { "darwin": "Cmd+Shift+[", "linux": "Ctrl+PageUp" },
      "category": "Tab"
    },
    {
      "command": "Go to Tab 1",
      "rawCommand": "ghostty.goto_tab:1",
      "key": { "darwin": "Cmd+1", "linux": "Alt+1" },
      "category": "Tab"
    },
    {
      "command": "Go to Tab 2",
      "rawCommand": "ghostty.goto_tab:2",
      "key": { "darwin": "Cmd+2", "linux": "Alt+2" },
      "category": "Tab"
    },
    {
      "command": "Go to Tab 3",
      "rawCommand": "ghostty.goto_tab:3",
      "key": { "darwin": "Cmd+3", "linux": "Alt+3" },
      "category": "Tab"
    },
    {
      "command": "Go to Tab 4",
      "rawCommand": "ghostty.goto_tab:4",
      "key": { "darwin": "Cmd+4", "linux": "Alt+4" },
      "category": "Tab"
    },
    {
      "command": "Go to Tab 5",
      "rawCommand": "ghostty.goto_tab:5",
      "key": { "darwin": "Cmd+5", "linux": "Alt+5" },
      "category": "Tab"
    },
    {
      "command": "New Window",
      "rawCommand": "ghostty.new_window",
      "key": { "darwin": "Cmd+N", "linux": "Ctrl+Shift+N" },
      "category": "Window"
    },
    {
      "command": "Toggle Fullscreen",
      "rawCommand": "ghostty.toggle_fullscreen",
      "key": { "darwin": "Ctrl+Cmd+F", "linux": "Ctrl+Enter" },
      "category": "Window"
    },
    {
      "command": "New Split Right",
      "rawCommand": "ghostty.new_split:right",
      "key": { "darwin": "Cmd+D", "linux": "Ctrl+Shift+O" },
      "category": "Split"
    },
    {
      "command": "New Split Down",
      "rawCommand": "ghostty.new_split:down",
      "key": { "darwin": "Cmd+Shift+D", "linux": "Ctrl+Shift+E" },
      "category": "Split"
    },
    {
      "command": "Navigate Split Left",
      "rawCommand": "ghostty.goto_split:left",
      "key": { "darwin": "Cmd+Alt+Left", "linux": "Ctrl+Alt+Left" },
      "category": "Split"
    },
    {
      "command": "Navigate Split Right",
      "rawCommand": "ghostty.goto_split:right",
      "key": { "darwin": "Cmd+Alt+Right", "linux": "Ctrl+Alt+Right" },
      "category": "Split"
    },
    {
      "command": "Navigate Split Up",
      "rawCommand": "ghostty.goto_split:up",
      "key": { "darwin": "Cmd+Alt+Up", "linux": "Ctrl+Alt+Up" },
      "category": "Split"
    },
    {
      "command": "Navigate Split Down",
      "rawCommand": "ghostty.goto_split:down",
      "key": { "darwin": "Cmd+Alt+Down", "linux": "Ctrl+Alt+Down" },
      "category": "Split"
    },
    {
      "command": "Equalize Splits",
      "rawCommand": "ghostty.equalize_splits",
      "key": { "darwin": "Cmd+Ctrl+=" },
      "category": "Split"
    },
    {
      "command": "Toggle Split Zoom",
      "rawCommand": "ghostty.toggle_split_zoom",
      "key": { "darwin": "Cmd+Shift+Enter", "linux": "Ctrl+Shift+Enter" },
      "category": "Split"
    },
    {
      "command": "Increase Font Size",
      "rawCommand": "ghostty.increase_font_size:1",
      "key": { "darwin": "Cmd+=", "linux": "Ctrl+=" },
      "category": "Font"
    },
    {
      "command": "Decrease Font Size",
      "rawCommand": "ghostty.decrease_font_size:1",
      "key": { "darwin": "Cmd+-", "linux": "Ctrl+-" },
      "category": "Font"
    },
    {
      "command": "Reset Font Size",
      "rawCommand": "ghostty.reset_font_size",
      "key": { "darwin": "Cmd+0", "linux": "Ctrl+0" },
      "category": "Font"
    },
    {
      "command": "Copy",
      "rawCommand": "ghostty.copy_to_clipboard",
      "key": { "darwin": "Cmd+C", "linux": "Ctrl+Shift+C" },
      "category": "Selection"
    },
    {
      "command": "Paste",
      "rawCommand": "ghostty.paste_from_clipboard",
      "key": { "darwin": "Cmd+V", "linux": "Ctrl+Shift+V" },
      "category": "Selection"
    },
    {
      "command": "Select All",
      "rawCommand": "ghostty.select_all",
      "key": { "darwin": "Cmd+A", "linux": "Ctrl+Shift+A" },
      "category": "Selection"
    },
    {
      "command": "Search",
      "rawCommand": "ghostty.start_search",
      "key": { "darwin": "Cmd+F", "linux": "Ctrl+Shift+F" },
      "category": "Navigation"
    },
    {
      "command": "Scroll to Top",
      "rawCommand": "ghostty.scroll_to_top",
      "key": { "darwin": "Cmd+Home", "linux": "Shift+Home" },
      "category": "Navigation"
    },
    {
      "command": "Scroll to Bottom",
      "rawCommand": "ghostty.scroll_to_bottom",
      "key": { "darwin": "Cmd+End", "linux": "Shift+End" },
      "category": "Navigation"
    },
    {
      "command": "Scroll Page Up",
      "rawCommand": "ghostty.scroll_page_up",
      "key": { "darwin": "Cmd+PageUp", "linux": "Shift+PageUp" },
      "category": "Navigation"
    },
    {
      "command": "Scroll Page Down",
      "rawCommand": "ghostty.scroll_page_down",
      "key": { "darwin": "Cmd+PageDown", "linux": "Shift+PageDown" },
      "category": "Navigation"
    },
    {
      "command": "Previous Split",
      "rawCommand": "ghostty.goto_split:previous",
      "key": { "darwin": "Cmd+[", "linux": "Ctrl+Super+[" },
      "category": "Split"
    },
    {
      "command": "Next Split",
      "rawCommand": "ghostty.goto_split:next",
      "key": { "darwin": "Cmd+]", "linux": "Ctrl+Super+]" },
      "category": "Split"
    },
    {
      "command": "Close Window",
      "rawCommand": "ghostty.close_window",
      "key": { "darwin": "Cmd+Shift+W", "linux": "Alt+F4" },
      "category": "Window"
    },
    {
      "command": "Quit",
      "rawCommand": "ghostty.quit",
      "key": { "darwin": "Cmd+Q", "linux": "Ctrl+Shift+Q" },
      "category": "Window"
    },
    {
      "command": "Command Palette",
      "rawCommand": "ghostty.toggle_command_palette",
      "key": { "darwin": "Cmd+Shift+P", "linux": "Ctrl+Shift+P" },
      "category": "General"
    },
    {
      "command": "Open Config",
      "rawCommand": "ghostty.open_config",
      "key": { "darwin": "Cmd+,", "linux": "Ctrl+," },
      "category": "General"
    },
    {
      "command": "Reload Config",
      "rawCommand": "ghostty.reload_config",
      "key": { "darwin": "Cmd+Shift+,", "linux": "Ctrl+Shift+," },
      "category": "General"
    },
    {
      "command": "Toggle Inspector",
      "rawCommand": "ghostty.inspector:toggle",
      "key": { "darwin": "Cmd+Alt+I", "linux": "Ctrl+Shift+I" },
      "category": "General"
    },
    {
      "command": "Jump to Previous Prompt",
      "rawCommand": "ghostty.jump_to_prompt:-1",
      "key": { "darwin": "Cmd+Up", "linux": "Ctrl+Shift+PageUp" },
      "category": "Navigation"
    },
    {
      "command": "Jump to Next Prompt",
      "rawCommand": "ghostty.jump_to_prompt:1",
      "key": { "darwin": "Cmd+Down", "linux": "Ctrl+Shift+PageDown" },
      "category": "Navigation"
    },
    {
      "command": "Clear Screen",
      "rawCommand": "ghostty.clear_screen",
      "key": { "darwin": "Cmd+K" },
      "category": "Navigation"
    }
  ]
}
