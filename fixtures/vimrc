" Vim Configuration
" Leader key
let mapleader = ","

" Basic mappings
nmap <leader>w :w<CR>
nmap <leader>q :q<CR>
nnoremap <C-p> :Files<CR>
vnoremap <C-c> "+y

" Insert mode mappings
inoremap jk <Esc>
imap <C-a> <Home>

" Command mode
cnoremap <C-a> <Home>

" Operator-pending
onoremap p i(

" Visual-only (x) and Select (s)
xnoremap < <gv
snoremap <C-j> <Down>

" Unmap
nunmap <C-z>

" Silent and buffer-local mapping
nmap <silent> <leader>f :FZF<CR>
nmap <buffer> <leader>b :Buffers<CR>

" Multi-modifier
nnoremap <C-S-k> :move .-1<CR>
nnoremap <D-s> :w<CR>

" Noremap (no prefix = normal mode)
noremap <Space> :
map j gj

" A later leader change only affects later mappings
let mapleader = "\<Space>"
let maplocalleader = ","
nnoremap <leader>ff :Telescope find_files<CR>
nnoremap <localleader>t :TestNearest<CR>
nnoremap <Up> <Nop>
nmap <Plug>(my-plug) :echo<CR>
map! <C-v> <C-r>+
nnoremap <C-]> g<C-]>
nnoremap gcc :Commentary<CR>
nnoremap W :w<CR>
tnoremap <Esc> <C-\><C-n>
