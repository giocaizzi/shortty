# Ghostty Configuration
font-family = JetBrains Mono
font-size = 14
theme = catppuccin-mocha

# Window settings
window-decoration = false

# Keybindings
keybind = cmd+t=new_tab
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+r=new_split:right
keybind = cmd+w=close_surface
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>l=goto_split:right
keybind = ctrl+a>j=goto_split:bottom
keybind = ctrl+a>k=goto_split:top
keybind = cmd+shift+enter=toggle_fullscreen
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# '=' as the trigger key (as printed by `ghostty +list-keybinds`)
keybind = super+ctrl+==equalize_splits
keybind = super++=increase_font_size:2

# Flags, physical keys, sequences, tables
keybind = global:ctrl+grave_accent=toggle_quick_terminal
keybind = unconsumed:performable:ctrl+shift+key_c=copy_to_clipboard
keybind = super+bracket_left=goto_split:previous
keybind = super+]=goto_split:next
keybind = physical:ctrl+one=goto_tab:1
keybind = ctrl+a>ctrl+a>c=new_window
keybind = vim/j=scroll_page_lines:1
keybind = chain=toggle_fullscreen
keybind = "super+shift+arrow_up=jump_to_prompt:-1"
keybind = super+backspace=text:\x15

# Remove a default
keybind = super+k=unbind
